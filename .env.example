# GEMINI_API_KEY: Optional if using Application Default Credentials (ADC) on Google Cloud.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY=
# Central AI Gateway (Unified Backend) non-secret configuration
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
GEMINI_GATEWAY_TIMEOUT_MS=45000
GEMINI_GATEWAY_MAX_RETRIES=3
AI_ENTITLEMENT_MODE=decoupled
# Server-side Gemini textbook generation tuning (non-secret configuration)
GEMINI_TEXTBOOK_MODEL=gemini-4-hydrogen
GEMINI_TEXTBOOK_TIMEOUT_MS=45000
GEMINI_TEXTBOOK_PROMPT_VERSION=v2.nerdc-grounded
# Shared-service entitlement policy ('decoupled' allows active instances with declared dependencies; 'strict' requires active commercial entitlement rows)
SHARED_SERVICE_ENTITLEMENT_MODE=decoupled

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Google Cloud ADC Configuration:
# When running without an API key, the system automatically uses Application Default Credentials (ADC) via Vertex AI / IAM.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=

# PostgreSQL (configure DATABASE_URL OR all explicit PG* values; inject secrets securely).
# DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=curriculum_platform
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full

# Disaster Recovery & Backup Configuration:
# CONTROL_PLANE_SECRET: Mandatory in production mode for signing bearer tokens and deriving keys.
CONTROL_PLANE_SECRET=
# PLATFORM_ADMIN_CREDENTIALS_JSON: Map of allowlisted emails to distinct 32+ character login keys.
PLATFORM_ADMIN_CREDENTIALS_JSON=
# INTERNAL_SERVICE_AUDIENCE: Exact audience expected in Google Cloud service ID tokens.
INTERNAL_SERVICE_AUDIENCE=
# INTERNAL_SERVICE_CALLERS: Comma-separated allowlisted Google service-account emails.
INTERNAL_SERVICE_CALLERS=
# INTERNAL_SERVICE_KEY: Legacy shared internal key (32+ characters); retain only during migration.
INTERNAL_SERVICE_KEY=
# INVITATION_EMAIL_API_KEY: Resend API key used to deliver first-school-administrator invitations.
INVITATION_EMAIL_API_KEY=
# INVITATION_EMAIL_FROM: Verified sender address for administrator invitations.
INVITATION_EMAIL_FROM=

# PostgreSQL:
# DATABASE_URL: Runtime connection for the PostgreSQL application role (not the migration owner).
DATABASE_URL=
# MIGRATION_DATABASE_URL: Optional, separately controlled migration role; used only by db:migrate commands.
MIGRATION_DATABASE_URL=
# DEMONSTRATION_MODE: Set to "true" only to enable explicitly demo-scoped endpoints.
DEMONSTRATION_MODE=false

# BACKUP_ENCRYPTION_KEY: Secret key used to encrypt and authenticate tenant backup archives (AES-256-GCM).
BACKUP_ENCRYPTION_KEY=

# BACKUP_STORAGE_DIR: Local durable path for backup artifacts. Defaults to ./data/backups/artifacts
BACKUP_STORAGE_DIR=

# BACKUP_STORAGE_PROVIDER: Storage backend ('local_durable', 'gcs_encrypted', 's3_encrypted'). Defaults to local_durable
BACKUP_STORAGE_PROVIDER=local_durable

# BACKUP_RETENTION_DAYS: Retention policy in days before automated pruning. Defaults to 30.
BACKUP_RETENTION_DAYS=30
