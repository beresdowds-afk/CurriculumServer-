# GEMINI_API_KEY: Optional if using Application Default Credentials (ADC) on Google Cloud.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Google Cloud ADC Configuration:
# When running without an API key, the system automatically uses Application Default Credentials (ADC) via Vertex AI / IAM.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=

# Disaster Recovery & Backup Configuration:
# CONTROL_PLANE_SECRET: Mandatory in production mode for signing bearer tokens and deriving keys.
CONTROL_PLANE_SECRET=

# BACKUP_ENCRYPTION_KEY: Secret key used to encrypt and authenticate tenant backup archives (AES-256-GCM).
BACKUP_ENCRYPTION_KEY=

# BACKUP_STORAGE_DIR: Local durable path for backup artifacts. Defaults to ./data/backups/artifacts
BACKUP_STORAGE_DIR=

# BACKUP_STORAGE_PROVIDER: Storage backend ('local_durable', 'gcs_encrypted', 's3_encrypted'). Defaults to local_durable
BACKUP_STORAGE_PROVIDER=local_durable

# BACKUP_RETENTION_DAYS: Retention policy in days before automated pruning. Defaults to 30.
BACKUP_RETENTION_DAYS=30
