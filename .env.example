# GEMINI_API_KEY: Optional if using Application Default Credentials (ADC) on Google Cloud.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# Google Cloud ADC Configuration (Eastforte Fabrications and Equipments organization):
# When running without an API key, the system automatically uses ADC via Vertex AI / IAM service accounts.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=
